server {
    listen 80;
    server_name twoja.local;

    root /var/www/twoja.local;
    index index.html;

    error_page 404 /404.html;
    error_page 500 502 503 504 /50x.html;

    location = /404.html {
	internal;
	error_page 404 = @not_found;
    }

    location = /50x.html {
	internal;
	error_page 404 = @not_found;
    }

    location @not_found {
	return 404;
    }

    location /pobierz/ {
        alias /var/www/twoja.local/pobierz/;

# Autoindex is enabled only for this download directory.
# Enabling it globally could expose sensitive files and the server's directory structure.

        autoindex on;
        autoindex_exact_size off;
        autoindex_localtime on;
    }
}
